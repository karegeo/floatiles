@article{meakin_effects_1984,
    title = {The effects of rotational diffusion on the fractal dimensionality of structures formed by cluster–cluster aggregation},
    volume = {81},
    issn = {0021-9606},
    url = {https://doi.org/10.1063/1.447398},
    doi = {10.1063/1.447398},
    abstract = {The effects of rotational diffusion on cluster–cluster aggregation have been investigated using two‐dimensional off lattice simulations. Earlier work has shown that, in the absence of rotational motion, diffusion limited cluster–cluster aggregation in two dimensions leads to structures with a fractal dimensionality (D) of 1.4–1.45. In the limit of very fast rotational diffusion (as compared to translational diffusion), the fractal dimensionality is 1.0 (for all Euclidean dimensionalities). For the model used in this paper to investigate the effects of rotational diffusion D varies continuously from a value of 1.40–1.45 to a limiting value of 1.0 as the rate of rotational diffusion is increased. Similar results are expected in higher dimensional simulations.},
    number = {10},
    urldate = {2026-04-26},
    journal = {The Journal of Chemical Physics},
    author = {Meakin, Paul},
    month = nov,
    year = {1984},
    pages = {4637--4639},
}