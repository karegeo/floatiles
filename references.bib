@article{bindi_natural_2009,
    title = {Natural {Quasicrystals}},
    volume = {324},
    url = {https://www.science.org/doi/full/10.1126/science.1170827},
    doi = {10.1126/science.1170827},
    abstract = {Quasicrystals are solids whose atomic arrangements have symmetries that are forbidden for periodic crystals, including configurations with fivefold symmetry. All examples identified to date have been synthesized in the laboratory under controlled conditions. Here we present evidence of a naturally occurring icosahedral quasicrystal that includes six distinct fivefold symmetry axes. The mineral, an alloy of aluminum, copper, and iron, occurs as micrometer-sized grains associated with crystalline khatyrkite and cupalite in samples reported to have come from the Koryak Mountains in Russia. The results suggest that quasicrystals can form and remain stable under geologic conditions, although there remain open questions as to how this mineral formed naturally.},
    number = {5932},
    urldate = {2026-04-07},
